<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SimHost</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <UseAppHost>false</UseAppHost>
    <RuntimeFrameworkVersion>10.0.0</RuntimeFrameworkVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <StripSymbols>true</StripSymbols>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <EnablePlatformAnalyzer>false</EnablePlatformAnalyzer>
    <!-- Critical: allow the SDK to resolve the NativeAOT runtime pack on iOS -->
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
  </PropertyGroup>

  <!-- Linux-only manual references. Skipped on iOS because implicit refs are enabled there. -->
  <ItemGroup Condition="'$(SimHostRuntimeDir)' != '' AND '$(DisableImplicitFrameworkReferences)' == 'true'">
    <Reference Include="$(SimHostRuntimeDir)/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SFOTH.Simulation">
      <HintPath>SFOTH.Simulation.dll</HintPath>
    </Reference>
    <Reference Include="SFOTH.Protocol">
      <HintPath>SFOTH.Protocol.dll</HintPath>
    </Reference>
    <Reference Include="BepuPhysics">
      <HintPath>BepuPhysics.dll</HintPath>
    </Reference>
    <Reference Include="BepuUtilities">
      <HintPath>BepuUtilities.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
