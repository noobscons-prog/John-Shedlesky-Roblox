<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SimHost</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <StripSymbols>true</StripSymbols>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SFOTH.Simulation">
      <HintPath>SFOTH.Simulation.dll</HintPath>
    </Reference>
    <Reference Include="SFOTH.Protocol">
      <HintPath>SFOTH.Protocol.dll</HintPath>
    </Reference>
    <Reference Include="BepuPhysics">
      <HintPath>BepuPhysics.dll</HintPath>
    </Reference>
    <Reference Include="BepuUtilities">
      <HintPath>BepuUtilities.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
